{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bonds",
  "identifier": "fyi.bonds",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "./web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "capabilities": [
        "main-window"
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "Bonds",
        "width": 1080,
        "height": 720,
        "minWidth": 540,
        "minHeight": 420,
        "center": true,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false
  }
}